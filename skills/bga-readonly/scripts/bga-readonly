#!/usr/bin/env python3
"""Restricted read commands for the organization-managed BGA client."""

import argparse
from contextlib import ExitStack
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import uuid


CLIENT = Path.home() / ".codex/skills/bga-connections/bga-connections"


def connection_id(value):
    try:
        return str(uuid.UUID(value))
    except ValueError as exc:
        raise argparse.ArgumentTypeError("connection must be a UUID") from exc


def provider_path(value):
    if not value.startswith("/") or value.startswith("//"):
        raise argparse.ArgumentTypeError("path must start with one slash")
    if any(char in value for char in ("?", "#", "\\")) or any(
        char.isspace() or ord(char) < 32 for char in value
    ):
        raise argparse.ArgumentTypeError("use --query for query parameters; invalid path")
    return value


def query_pair(value):
    if "=" not in value or not value.split("=", 1)[0]:
        raise argparse.ArgumentTypeError("query must be a nonempty key=value pair")
    return value


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("list", "permissions", "get"):
        command = commands.add_parser(name, allow_abbrev=False)
        command.add_argument("--output", type=Path, help="save to a new file (no overwrite)")
        if name != "list":
            command.add_argument("connection", type=connection_id)
        if name == "get":
            command.add_argument("--path", required=True, type=provider_path)
            command.add_argument("--query", action="append", type=query_pair, default=[])
    args = parser.parse_args(argv)

    if args.output is not None and os.path.lexists(args.output):
        parser.error("output already exists; choose a new file")
    if not CLIENT.is_file():
        parser.error(f"organization client not found: {CLIENT}")

    # Never forward arbitrary options, accept a caller-selected executable, or use a shell.
    command = [str(CLIENT)]
    if args.command == "get":
        command += ["call", args.connection, "--method", "GET", f"--path={args.path}"]
        command += [f"--query={pair}" for pair in args.query]
    elif args.command == "permissions":
        command += ["permissions", args.connection]
    else:
        command += ["list"]

    try:
        with ExitStack() as stack:
            download = None
            if args.command == "get" and args.output is not None:
                directory = stack.enter_context(tempfile.TemporaryDirectory(prefix="bga-readonly-"))
                download = Path(directory) / "response"
                command[1] = "download"
                command += ["--output", str(download)]
            result = subprocess.run(
                command, stdout=subprocess.PIPE if args.output is not None else None,
                check=False,
            )
            if result.returncode:
                if args.output is not None and result.stdout:
                    sys.stderr.buffer.write(result.stdout)
                return result.returncode if result.returncode > 0 else 128 - result.returncode
            if args.output is not None:
                # Exclusive creation rejects symlinks/races and never replaces existing data.
                data = download.read_bytes() if download is not None else result.stdout
                fd = os.open(args.output, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, "wb") as output:
                    output.write(data)
                print(f"Saved response to {args.output}")
    except OSError as exc:
        print(f"bga-readonly: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
